#!/bin/bash
# lxc-expose — publie un service d'un container en HTTPS sur <sous-domaine>.example.fr
#   (vhost nginx dans le container `nginx` + certificat Let's Encrypt webroot ECDSA).
#
# Usage : lxc-expose <sous-domaine> <ip:port> [--auth] [--ws] [--force]
#           --auth   : tout le site derrière TinyAuth (auth.example.fr)
#           --ws     : WebSocket / SSE (upgrade + buffering off)
#           --force  : remplace un conf.d/<sous-domaine>.conf non créé par lxc-expose (backup gardé)
#         lxc-expose --retry   : reprend les demandes en attente de DNS (lancé par lxc-expose.timer)
#         lxc-expose --list    : demandes en attente
#
# Certificat : le wildcard *.example.fr (certbot --dns-ovh, renouvelé seul) est utilisé s'il existe ;
# sinon, certificat dédié au sous-domaine (webroot).
# Si le DNS ne pointe pas encore sur le VPS, la demande est mise en attente dans $PENDING
# et lxc-expose.timer la termine toute seule (toutes les 10 min) dès que le DNS est prêt.
set -euo pipefail
ZONE=example.fr; VPS="<ip_publique>"; NGX=nginx   # à adapter : domaine et IP publique du serveur
PENDING=/var/lib/lxc-expose/pending
WILDCARD=/etc/letsencrypt/live/wildcard.$ZONE
MARK="# géré par lxc-expose"
mkdir -p "$PENDING"

na()  { lxc-attach -n "$NGX" -- "$@"; }
log() { echo "[lxc-expose] $*"; logger -t lxc-expose -- "$*" 2>/dev/null || true; }

dns_ok() { [ "$(getent ahostsv4 "$1" | awk 'NR==1{print $1}')" = "$VPS" ]; }

reload_or_restore() { # reload_or_restore <conf> <backup|"">
    if na nginx -t 2>/dev/null; then na nginx -s reload 2>/dev/null; return 0; fi
    if [ -n "$2" ]; then na cp -p "$2" "$1"; else na rm -f "$1"; fi
    na nginx -s reload 2>/dev/null || true
    log "ERREUR nginx -t sur $1 — configuration précédente restaurée"; return 1
}

write_http() { # vhost 80 seul : challenge ACME + redirection (avant d'avoir le certificat)
    local fqdn=$1 name=$2
    na sh -c "cat > /etc/nginx/conf.d/$name.conf" <<EOF
$MARK — $fqdn (HTTP seul, en attente du certificat)
server {
    listen 80;
    server_name $fqdn;
    include snippets/acme-challenge.conf;
    location / { return 301 https://\$host\$request_uri; }
    access_log /var/log/nginx/$name.access.log proxy;
    error_log  /var/log/nginx/$name.error.log;
}
EOF
}

write_https() {
    local fqdn=$1 name=$2 up=$3 auth=$4 ws=$5 certdir=$6 proxy_inc protect="" endpoint=""
    proxy_inc="include snippets/proxy-common.conf;"
    [ "$ws" = 1 ] && proxy_inc="include snippets/proxy-pocketbase.conf;   # proxy-common + WebSocket/SSE"
    if [ "$auth" = 1 ]; then
        endpoint="    include snippets/tinyauth-endpoint.conf;"
        protect="        include snippets/tinyauth-protect.conf;"
    fi
    na sh -c "cat > /etc/nginx/conf.d/$name.conf" <<EOF
$MARK — $fqdn -> http://$up$( [ "$auth" = 1 ] && echo " (TinyAuth)" )
# options : auth=$auth ws=$ws
server {
    listen 80;
    server_name $fqdn;
    include snippets/acme-challenge.conf;
    location / { return 301 https://\$host\$request_uri; }
    access_log /var/log/nginx/$name.access.log proxy;
    error_log  /var/log/nginx/$name.error.log;
}
server {
    listen 443 ssl http2;
    server_name $fqdn;
    ssl_certificate     $certdir/fullchain.pem;
    ssl_certificate_key $certdir/privkey.pem;
    include snippets/ssl-params.conf;
    include snippets/security-headers.conf;
    access_log /var/log/nginx/$name.access.log proxy;
    error_log  /var/log/nginx/$name.error.log;
$endpoint
    location / {
$protect
        proxy_pass http://$up;
        $proxy_inc
    }
}
EOF
}

expose() { # expose <sous-domaine> <ip:port> <auth> <ws> <force>
    local name=$1 up=$2 auth=$3 ws=$4 force=$5 fqdn conf bak=""
    fqdn="$name.$ZONE"; conf="/etc/nginx/conf.d/$name.conf"

    if na test -f "$conf" && ! na grep -q "^$MARK" "$conf"; then
        [ "$force" = 1 ] || { log "$conf existe et n'est pas géré par lxc-expose (--force pour le remplacer)"; return 1; }
    fi
    if na test -f "$conf"; then
        bak="/root/nginx-conf-backups/$name.conf.$(date +%F_%H%M%S)"
        na mkdir -p /root/nginx-conf-backups; na cp -p "$conf" "$bak"
    fi

    if ! dns_ok "$fqdn"; then
        printf '%s %s %s %s %s\n' "$name" "$up" "$auth" "$ws" "$force" > "$PENDING/$name"
        log "$fqdn : DNS pas encore sur $VPS — demande mise en attente (reprise auto toutes les 10 min)"
        return 0
    fi

    local certdir="/etc/letsencrypt/live/$fqdn"
    if na test -f "$WILDCARD/fullchain.pem"; then
        certdir=$WILDCARD   # *.example.fr couvre tout sous-domaine d'un seul niveau
    elif ! na test -f "$certdir/fullchain.pem"; then
        write_http "$fqdn" "$name"; reload_or_restore "$conf" "$bak"
        if ! na certbot certonly --webroot -w /var/www/certbot -d "$fqdn" --key-type ecdsa \
                --non-interactive --agree-tos --no-eff-email --register-unsafely-without-email --quiet; then
            if [ -n "$bak" ]; then na cp -p "$bak" "$conf"; else na rm -f "$conf"; fi
            na nginx -s reload || true
            printf '%s %s %s %s %s\n' "$name" "$up" "$auth" "$ws" "$force" > "$PENDING/$name"
            log "$fqdn : échec certbot (voir /var/log/letsencrypt dans $NGX) — nouvel essai plus tard"
            return 1
        fi
    fi

    write_https "$fqdn" "$name" "$up" "$auth" "$ws" "$certdir"
    reload_or_restore "$conf" "$bak"
    rm -f "$PENDING/$name"
    local code
    sleep 2   # "nginx -s reload" est asynchrone
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' --resolve "$fqdn:443:10.0.3.10" "https://$fqdn/" || true)
    log "✔ https://$fqdn -> $up en ligne (HTTP $code)"
}

case "${1:-}" in
    --list)  ls -1 "$PENDING" 2>/dev/null | while read -r f; do cat "$PENDING/$f"; done; exit 0 ;;
    --retry)
        rc=0
        for f in "$PENDING"/*; do
            [ -e "$f" ] || continue
            read -r n u a w fo < "$f"
            dns_ok "$n.$ZONE" || continue
            expose "$n" "$u" "$a" "$w" "$fo" || rc=1
        done
        exit $rc ;;
    ""|-h|--help) sed -n 2,14p "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

NAME=$1; UP=${2:?ip:port manquant}; shift 2
AUTH=0; WS=0; FORCE=0
for o in "$@"; do case $o in --auth) AUTH=1;; --ws) WS=1;; --force) FORCE=1;; *) echo "option inconnue : $o"; exit 2;; esac; done
[[ "$NAME" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || { echo "sous-domaine invalide : $NAME"; exit 2; }
[[ "$UP" =~ ^10\.0\.3\.[0-9]{1,3}:[0-9]{1,5}$ ]] || { echo "cible invalide : $UP (attendu 10.0.3.x:port)"; exit 2; }
expose "$NAME" "$UP" "$AUTH" "$WS" "$FORCE"
